# ── MkDocs 本地构建产物 ──────────────────────────────────────────
# mkdocs.yml 的 site_dir 指向 site/，仅在本地构建时生成，产物以根目录
# 的 index.html、assets/ 等形式落地并单独提交，site/ 本身不入库。
site/

# ── 工具缓存 ────────────────────────────────────────────────────
# tools/gen_sitemap.py 的线上校验缓存，含机器相关的时间戳，不入库。
.sitemap-cache.json

# ── 编辑器 / 系统 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── AtomCode 本地会话数据 ────────────────────────────────────────
.atomcode/
